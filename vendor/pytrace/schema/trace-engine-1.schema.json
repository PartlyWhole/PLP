{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pytrace:schema:trace-engine:1",
  "title": "PyTrace trace-engine/1 canonical record",
  "description": "One record in a PyTrace v1 NDJSON stream. Cross-record ordering and referential invariants are defined by the implementation plan.",
  "oneOf": [
    {
      "$ref": "#/$defs/HeaderRecord"
    },
    {
      "$ref": "#/$defs/StepRecord"
    },
    {
      "$ref": "#/$defs/DiagnosticRecord"
    },
    {
      "$ref": "#/$defs/TerminalRecord"
    }
  ],
  "$defs": {
    "NonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "Uid": {
      "$ref": "#/$defs/PositiveInteger"
    },
    "FrameId": {
      "$ref": "#/$defs/PositiveInteger"
    },
    "EnvironmentId": {
      "$ref": "#/$defs/PositiveInteger"
    },
    "TraceOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_heap_nodes",
        "max_heap_edges",
        "max_container_elems",
        "max_output_bytes",
        "max_record_bytes",
        "max_trace_bytes",
        "max_source_bytes",
        "max_input_line_bytes",
        "wall_clock_s",
        "identity_tombstones",
        "trace_modules",
        "show_dunder_attributes",
        "echo_stdin"
      ],
      "properties": {
        "max_steps": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_heap_nodes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_heap_edges": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_container_elems": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_output_bytes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_record_bytes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_trace_bytes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_source_bytes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "max_input_line_bytes": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "wall_clock_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "identity_tombstones": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "trace_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "show_dunder_attributes": {
          "type": "boolean"
        },
        "echo_stdin": {
          "type": "boolean"
        }
      }
    },
    "HostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_input",
        "cooperative_interrupt",
        "hard_interrupt",
        "process_group",
        "cpu_limit",
        "address_space_limit",
        "cross_origin_isolated"
      ],
      "properties": {
        "live_input": {
          "type": "boolean"
        },
        "cooperative_interrupt": {
          "type": "boolean"
        },
        "hard_interrupt": {
          "type": "boolean"
        },
        "process_group": {
          "type": "boolean"
        },
        "cpu_limit": {
          "type": "boolean"
        },
        "address_space_limit": {
          "type": "boolean"
        },
        "cross_origin_isolated": {
          "type": "boolean"
        }
      }
    },
    "HostInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runtime",
        "platform",
        "input_mode",
        "python_hash_seed",
        "capabilities"
      ],
      "properties": {
        "kind": {
          "enum": [
            "in_process",
            "native_subprocess",
            "browser_worker"
          ]
        },
        "runtime": {
          "enum": [
            "cpython",
            "pyodide"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "input_mode": {
          "enum": [
            "live",
            "pre_supplied"
          ]
        },
        "python_hash_seed": {
          "enum": [
            "0",
            "uncontrolled",
            "not_applicable"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/HostCapabilities"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "in_process"
            },
            "runtime": {
              "const": "cpython"
            },
            "platform": {
              "enum": [
                "linux",
                "macos"
              ]
            },
            "python_hash_seed": {
              "const": "uncontrolled"
            },
            "capabilities": {
              "properties": {
                "cooperative_interrupt": {
                  "const": false
                },
                "hard_interrupt": {
                  "const": false
                },
                "process_group": {
                  "const": false
                },
                "cpu_limit": {
                  "const": false
                },
                "address_space_limit": {
                  "const": false
                },
                "cross_origin_isolated": {
                  "const": false
                }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "input_mode": {
                  "const": "live"
                },
                "capabilities": {
                  "properties": {
                    "live_input": {
                      "const": true
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "input_mode": {
                  "const": "pre_supplied"
                },
                "capabilities": {
                  "properties": {
                    "live_input": {
                      "const": false
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "native_subprocess"
            },
            "runtime": {
              "const": "cpython"
            },
            "platform": {
              "enum": [
                "linux",
                "macos"
              ]
            },
            "python_hash_seed": {
              "const": "0"
            },
            "capabilities": {
              "properties": {
                "live_input": {
                  "const": true
                },
                "cooperative_interrupt": {
                  "const": true
                },
                "hard_interrupt": {
                  "const": true
                },
                "process_group": {
                  "const": true
                },
                "cross_origin_isolated": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "browser_worker"
            },
            "runtime": {
              "const": "pyodide"
            },
            "platform": {
              "const": "browser"
            },
            "python_hash_seed": {
              "const": "not_applicable"
            },
            "capabilities": {
              "properties": {
                "hard_interrupt": {
                  "const": true
                },
                "process_group": {
                  "const": false
                },
                "cpu_limit": {
                  "const": false
                },
                "address_space_limit": {
                  "const": false
                }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "input_mode": {
                  "enum": [
                    "live",
                    "pre_supplied"
                  ]
                },
                "capabilities": {
                  "properties": {
                    "live_input": {
                      "const": true
                    },
                    "cooperative_interrupt": {
                      "const": true
                    },
                    "cross_origin_isolated": {
                      "const": true
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "input_mode": {
                  "const": "pre_supplied"
                },
                "capabilities": {
                  "properties": {
                    "live_input": {
                      "const": false
                    },
                    "cooperative_interrupt": {
                      "const": false
                    },
                    "cross_origin_isolated": {
                      "const": false
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "HeaderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seq",
        "format",
        "run_id",
        "engine_version",
        "python_version",
        "backend",
        "source",
        "source_sha256",
        "options",
        "host"
      ],
      "properties": {
        "kind": {
          "const": "header"
        },
        "seq": {
          "const": 0
        },
        "format": {
          "const": "trace-engine/1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "const": "settrace"
        },
        "source": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "options": {
          "$ref": "#/$defs/TraceOptions"
        },
        "host": {
          "$ref": "#/$defs/HostInfo"
        }
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "module",
        "function",
        "line"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NoneValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "none"
        }
      }
    },
    "BoolValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "bool"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "IntValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "decimal"
      ],
      "properties": {
        "kind": {
          "const": "int"
        },
        "decimal": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        }
      }
    },
    "FiniteFloatValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "decimal"
      ],
      "properties": {
        "kind": {
          "const": "float"
        },
        "decimal": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?)(?:[eE][+-]?[0-9]+)?$"
        }
      }
    },
    "SpecialFloatValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "special"
      ],
      "properties": {
        "kind": {
          "const": "float"
        },
        "special": {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      }
    },
    "FloatValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/FiniteFloatValue"
        },
        {
          "$ref": "#/$defs/SpecialFloatValue"
        }
      ]
    },
    "StrValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "str"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "BytesValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base64",
        "length"
      ],
      "properties": {
        "kind": {
          "const": "bytes"
        },
        "base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        },
        "length": {
          "$ref": "#/$defs/NonNegativeInteger"
        }
      }
    },
    "ComplexValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "real",
        "imag"
      ],
      "properties": {
        "kind": {
          "const": "complex"
        },
        "real": {
          "$ref": "#/$defs/FloatValue"
        },
        "imag": {
          "$ref": "#/$defs/FloatValue"
        }
      }
    },
    "RangeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "stop",
        "step"
      ],
      "properties": {
        "kind": {
          "const": "range"
        },
        "start": {
          "$ref": "#/$defs/IntValue"
        },
        "stop": {
          "$ref": "#/$defs/IntValue"
        },
        "step": {
          "$ref": "#/$defs/IntValue"
        }
      }
    },
    "SliceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "stop",
        "step"
      ],
      "properties": {
        "kind": {
          "const": "slice"
        },
        "start": {
          "$ref": "#/$defs/EncodedValue"
        },
        "stop": {
          "$ref": "#/$defs/EncodedValue"
        },
        "step": {
          "$ref": "#/$defs/EncodedValue"
        }
      }
    },
    "EllipsisValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "ellipsis"
        }
      }
    },
    "NotImplementedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "not_implemented"
        }
      }
    },
    "RefValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uid"
      ],
      "properties": {
        "kind": {
          "const": "ref"
        },
        "uid": {
          "$ref": "#/$defs/Uid"
        }
      }
    },
    "ElidedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "elided"
        },
        "reason": {
          "enum": [
            "node_limit",
            "edge_limit",
            "container_limit",
            "record_limit",
            "unsafe_access"
          ]
        },
        "omitted_count": {
          "$ref": "#/$defs/NonNegativeInteger"
        }
      }
    },
    "ScalarValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/NoneValue"
        },
        {
          "$ref": "#/$defs/BoolValue"
        },
        {
          "$ref": "#/$defs/IntValue"
        },
        {
          "$ref": "#/$defs/FloatValue"
        },
        {
          "$ref": "#/$defs/StrValue"
        },
        {
          "$ref": "#/$defs/BytesValue"
        },
        {
          "$ref": "#/$defs/ComplexValue"
        },
        {
          "$ref": "#/$defs/RangeValue"
        },
        {
          "$ref": "#/$defs/SliceValue"
        },
        {
          "$ref": "#/$defs/EllipsisValue"
        },
        {
          "$ref": "#/$defs/NotImplementedValue"
        }
      ]
    },
    "SetSliceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "stop",
        "step"
      ],
      "properties": {
        "kind": {
          "const": "slice"
        },
        "start": {
          "$ref": "#/$defs/SetScalarValue"
        },
        "stop": {
          "$ref": "#/$defs/SetScalarValue"
        },
        "step": {
          "$ref": "#/$defs/SetScalarValue"
        }
      }
    },
    "SetScalarValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/NoneValue"
        },
        {
          "$ref": "#/$defs/BoolValue"
        },
        {
          "$ref": "#/$defs/IntValue"
        },
        {
          "$ref": "#/$defs/FloatValue"
        },
        {
          "$ref": "#/$defs/StrValue"
        },
        {
          "$ref": "#/$defs/BytesValue"
        },
        {
          "$ref": "#/$defs/ComplexValue"
        },
        {
          "$ref": "#/$defs/RangeValue"
        },
        {
          "$ref": "#/$defs/SetSliceValue"
        },
        {
          "$ref": "#/$defs/EllipsisValue"
        },
        {
          "$ref": "#/$defs/NotImplementedValue"
        }
      ]
    },
    "EncodedValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScalarValue"
        },
        {
          "$ref": "#/$defs/RefValue"
        },
        {
          "$ref": "#/$defs/ElidedValue"
        }
      ]
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/EncodedValue"
        }
      }
    },
    "Bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Binding"
      }
    },
    "ClosureCellBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/RefValue"
        }
      }
    },
    "ClosureCellBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClosureCellBinding"
      }
    },
    "FrameSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "function",
        "module",
        "location",
        "locals"
      ],
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/FrameId"
        },
        "function": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "locals": {
          "$ref": "#/$defs/Bindings"
        }
      }
    },
    "GlobalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "bindings"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "bindings": {
          "$ref": "#/$defs/Bindings"
        }
      }
    },
    "ClosureEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "cells"
      ],
      "properties": {
        "environment_id": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "cells": {
          "$ref": "#/$defs/ClosureCellBindings"
        }
      }
    },
    "SequenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "kind",
        "type_name",
        "ordering",
        "items",
        "elided_count"
      ],
      "properties": {
        "uid": {
          "$ref": "#/$defs/Uid"
        },
        "kind": {
          "enum": [
            "list",
            "tuple",
            "set",
            "frozenset"
          ]
        },
        "type_name": {
          "type": "string"
        },
        "ordering": {
          "enum": [
            "insertion",
            "canonical",
            "unordered"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EncodedValue"
          }
        },
        "elided_count": {
          "$ref": "#/$defs/NonNegativeInteger"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "list",
                  "tuple"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ordering": {
                "const": "insertion"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "set",
                  "frozenset"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/SetScalarValue"
                  }
                },
                "elided_count": {
                  "const": 0
                }
              },
              "required": [
                "items",
                "elided_count"
              ]
            },
            "then": {
              "properties": {
                "ordering": {
                  "const": "canonical"
                }
              }
            },
            "else": {
              "properties": {
                "ordering": {
                  "const": "unordered"
                }
              }
            }
          }
        }
      ]
    },
    "DictEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/EncodedValue"
        },
        "value": {
          "$ref": "#/$defs/EncodedValue"
        }
      }
    },
    "DictNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "kind",
        "type_name",
        "entries",
        "elided_count"
      ],
      "properties": {
        "uid": {
          "$ref": "#/$defs/Uid"
        },
        "kind": {
          "const": "dict"
        },
        "type_name": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DictEntry"
          }
        },
        "elided_count": {
          "$ref": "#/$defs/NonNegativeInteger"
        }
      }
    },
    "FunctionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "kind",
        "type_name",
        "module",
        "qualname",
        "provenance"
      ],
      "properties": {
        "uid": {
          "$ref": "#/$defs/Uid"
        },
        "kind": {
          "const": "function"
        },
        "type_name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "qualname": {
